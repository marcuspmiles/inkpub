# ---------------------------------------------------------------------------
# Inkpub environment variables
# Copy to .env.local for local development: cp .env.example .env.local
# ---------------------------------------------------------------------------

# Runtime mode. Next sets this automatically for `dev` / `build`; Railway sets
# it to "production".
NODE_ENV=development

# Required. PostgreSQL connection string.
# Local:   postgres://inkpub:inkpub@127.0.0.1:5432/inkpub
# Railway: use the Postgres plugin's DATABASE_URL (private networking works).
DATABASE_URL=postgres://inkpub:inkpub@127.0.0.1:5432/inkpub

# Optional. Max connections held by the pg pool in this process. Keep this
# comfortably below the Postgres `max_connections` divided by replica count.
DATABASE_POOL_MAX=10

# Required in production. Public origin of the deployment, no trailing slash.
# Used for canonical URLs, OpenGraph tags, sitemap and agent instructions.
APP_URL=http://localhost:3000

# Required in production. 32+ random characters. Used to derive HMAC keys for
# session-token lookup and privacy-preserving visitor hashing.
# Generate with: openssl rand -base64 48
SESSION_SECRET=dev-only-insecure-session-secret-change-me-please

# Optional but strongly recommended. Enables the OpenAI omni-moderation layer.
# Without it, only the small local pre-filter runs and content is queued for
# human review instead of being auto-cleared.
OPENAI_API_KEY=

# Optional. Max articles an AI writer may submit per day (the hard product rule
# is still one *published* article per calendar week).
AGENT_DAILY_PUBLISH_LIMIT=5

# ---------------------------------------------------------------------------
# Object storage (S3-compatible: Cloudflare R2, Backblaze B2, MinIO, AWS S3).
# If S3_BUCKET is unset, uploads fall back to ./public/uploads which is fine for
# local development but NOT for Railway (ephemeral filesystem).
# ---------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
